        {
            "name": "2. Staff Management",
            "description": "Admin fills in skeleton details and activates self-registered users. Uses the SAME UIDs from registration — no new staff created.",
            "item": [
                {
                    "name": "Fill in Raf's details + assign to Lucy",
                    "request": { "method": "PATCH", "url": "{{base_url}}/staff/{{staff1_uid}}", "header": [{"key":"Content-Type","value":"application/json"}], "body": {"mode":"raw","raw":"{\n    \"department\": \"Networks\",\n    \"lineManagerId\": \"{{manager1_uid}}\",\n    \"currentRole\": \"Apprentice Software Engineer\",\n    \"startDateOfCurrentRole\": \"2025-09-01\",\n    \"jobLevel\": \"JUNIOR\",\n    \"employmentType\": \"FULL_TIME\"\n}"}, "auth": {"type":"bearer","bearer":[{"key":"token","value":"{{jwt_admin_token}}"}]} },
                    "event": [{"listen":"test","script":{"exec":["pm.test('200', function() { pm.response.to.have.status(200); });"]}}]
                },
                {
