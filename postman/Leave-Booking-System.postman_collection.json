        {
            "name": "3. Leave Requests — Commands",
            "item": [
                {
                    "name": "Submit — Raf (5 days)",
                    "request": { "method": "POST", "url": "{{base_url}}/leave-requests", "header": [{"key":"Content-Type","value":"application/json"}], "body": {"mode":"raw","raw":"{\n    \"managerId\": \"{{manager1_uid}}\",\n    \"startDate\": \"2026-09-15\",\n    \"endDate\": \"2026-09-19\",\n    \"leaveType\": \"ANNUAL\",\n    \"reason\": \"Family holiday to Portugal\"\n}"}, "auth": {"type":"bearer","bearer":[{"key":"token","value":"{{jwt_staff1_token}}"}]} },
                    "event": [{"listen":"test","script":{"exec":["pm.test('201', function() { pm.response.to.have.status(201); });","pm.test('PENDING', function() { pm.expect(pm.response.json().status).to.equal('PENDING'); });","pm.environment.set('leave_request_id', pm.response.json().id);"]}}]
                },
                {
                    "name": "Submit — Past Date (expect 400)",
                    "request": { "method": "POST", "url": "{{base_url}}/leave-requests", "header": [{"key":"Content-Type","value":"application/json"}], "body": {"mode":"raw","raw":"{\n    \"managerId\": \"{{manager1_uid}}\",\n    \"startDate\": \"2025-01-01\",\n    \"endDate\": \"2025-01-05\",\n    \"leaveType\": \"ANNUAL\"\n}"}, "auth": {"type":"bearer","bearer":[{"key":"token","value":"{{jwt_staff1_token}}"}]} },
                    "event": [{"listen":"test","script":{"exec":["pm.test('400', function() { pm.response.to.have.status(400); });"]}}]
                },
                {
                    "name": "Submit — End Before Start (expect 400)",
                    "request": { "method": "POST", "url": "{{base_url}}/leave-requests", "header": [{"key":"Content-Type","value":"application/json"}], "body": {"mode":"raw","raw":"{\n    \"managerId\": \"{{manager1_uid}}\",\n    \"startDate\": \"2026-10-15\",\n    \"endDate\": \"2026-10-10\",\n    \"leaveType\": \"ANNUAL\"\n}"}, "auth": {"type":"bearer","bearer":[{"key":"token","value":"{{jwt_staff1_token}}"}]} },
                    "event": [{"listen":"test","script":{"exec":["pm.test('400', function() { pm.response.to.have.status(400); });"]}}]
                },
                {
                    "name": "Submit — No Token (expect 401)",
                    "request": { "method": "POST", "url": "{{base_url}}/leave-requests", "header": [{"key":"Content-Type","value":"application/json"}], "body": {"mode":"raw","raw":"{\n    \"managerId\": \"{{manager1_uid}}\",\n    \"startDate\": \"2026-10-15\",\n    \"endDate\": \"2026-10-19\",\n    \"leaveType\": \"ANNUAL\"\n}"}, "auth": {"type":"noauth"} },
                    "event": [{"listen":"test","script":{"exec":["pm.test('401', function() { pm.response.to.have.status(401); });"]}}]
                },
                {
                    "name": "Approve — Lucy",
                    "request": { "method": "PATCH", "url": "{{base_url}}/leave-requests/{{leave_request_id}}/approve", "header": [{"key":"Content-Type","value":"application/json"}], "body": {"mode":"raw","raw":"{\n    \"reason\": \"Enjoy your holiday!\"\n}"}, "auth": {"type":"bearer","bearer":[{"key":"token","value":"{{jwt_manager1_token}}"}]} },
                    "event": [{"listen":"test","script":{"exec":["pm.test('200', function() { pm.response.to.have.status(200); });","pm.test('APPROVED', function() { pm.expect(pm.response.json().status).to.equal('APPROVED'); });"]}}]
                },
                {
                    "name": "Approve — Already (expect 409)",
                    "request": { "method": "PATCH", "url": "{{base_url}}/leave-requests/{{leave_request_id}}/approve", "auth": {"type":"bearer","bearer":[{"key":"token","value":"{{jwt_manager1_token}}"}]} },
                    "event": [{"listen":"test","script":{"exec":["pm.test('409 or 400', function() { pm.expect(pm.response.code).to.be.oneOf([409, 400]); });"]}}]
                },
                {
                    "name": "Approve — Staff (expect 403)",
                    "request": { "method": "PATCH", "url": "{{base_url}}/leave-requests/{{leave_request_id}}/approve", "auth": {"type":"bearer","bearer":[{"key":"token","value":"{{jwt_staff1_token}}"}]} },
                    "event": [{"listen":"test","script":{"exec":["pm.test('403', function() { pm.response.to.have.status(403); });"]}}]
                },
                {
                    "name": "Approve — Wrong Manager (expect 403)",
                    "request": { "method": "PATCH", "url": "{{base_url}}/leave-requests/{{leave_request_id}}/approve", "auth": {"type":"bearer","bearer":[{"key":"token","value":"{{jwt_manager2_token}}"}]} },
                    "event": [{"listen":"test","script":{"exec":["pm.test('403', function() { pm.response.to.have.status(403); });"]}}]
                },
                {
                    "name": "Cancel Approved — Raf",
                    "request": { "method": "PATCH", "url": "{{base_url}}/leave-requests/{{leave_request_id}}/cancel", "header": [{"key":"Content-Type","value":"application/json"}], "body": {"mode":"raw","raw":"{\n    \"reason\": \"Plans changed\"\n}"}, "auth": {"type":"bearer","bearer":[{"key":"token","value":"{{jwt_staff1_token}}"}]} },
                    "event": [{"listen":"test","script":{"exec":["pm.test('200', function() { pm.response.to.have.status(200); });","pm.test('CANCELLED', function() { pm.expect(pm.response.json().status).to.equal('CANCELLED'); });"]}}]
                },
                {
                    "name": "Submit 2nd — for reject",
                    "request": { "method": "POST", "url": "{{base_url}}/leave-requests", "header": [{"key":"Content-Type","value":"application/json"}], "body": {"mode":"raw","raw":"{\n    \"managerId\": \"{{manager1_uid}}\",\n    \"startDate\": \"2026-11-02\",\n    \"endDate\": \"2026-11-06\",\n    \"leaveType\": \"ANNUAL\",\n    \"reason\": \"Christmas shopping\"\n}"}, "auth": {"type":"bearer","bearer":[{"key":"token","value":"{{jwt_staff1_token}}"}]} },
                    "event": [{"listen":"test","script":{"exec":["pm.test('201', function() { pm.response.to.have.status(201); });","pm.environment.set('leave_request_id_2', pm.response.json().id);"]}}]
                },
                {
